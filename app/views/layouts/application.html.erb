<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Mega Bike</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <%= stylesheet_link_tag "application", media: "all" %>
    <%= javascript_include_tag "application", defer: true %>
  </head>

  <body class="mbk-body">
    <nav class="navbar navbar-expand-lg navbar-dark mbk-nav">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">Mega Bike</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" href="/nosotros">Nosotros</a></li>
            <li class="nav-item"><a class="nav-link" href="/products">Productos</a></li>
            <li class="nav-item"><a class="nav-link" href="/appointments/new">Servicios</a></li>
            <li class="nav-item"><a class="nav-link" href="/custom_quotes/new">Personalizado</a></li>
            <li class="nav-item"><a class="nav-link" href="/faq">FAQ</a></li>
          </ul>

          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/cart"><i class="fa-solid fa-cart-shopping"></i> Carrito</a>
            </li>

            <% if logged_in? %>
              <% if admin? %>
                <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
              <% end %>
              <li class="nav-item"><span class="navbar-text me-2">Hola, <%= current_user.name %></span></li>
              <li class="nav-item">
                <%= button_to "Salir", logout_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
              </li>
            <% else %>
              <li class="nav-item"><a class="nav-link" href="/login">Ingresar</a></li>
              <li class="nav-item"><a class="btn btn-warning btn-sm ms-2" href="/registro">Crear cuenta</a></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="border-top py-4 bg-white">
      <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
        <div>
          <div class="fw-bold">Mega Bike</div>
          <div class="text-muted">Bicicleteria · Ventas · Service</div>
        </div>
        <div class="text-muted">© <%= Time.current.year %> Mega Bike</div>
      </div>
    </footer>

    <% if support_whatsapp_url.present? %>
      <div
        class="mbk-support"
        data-whatsapp-url="<%= support_whatsapp_url %>"
        data-ai-enabled="<%= (ENV['SUPPORT_AI_ENABLED'].to_s.strip == '' ? '1' : ENV['SUPPORT_AI_ENABLED'].to_s.strip) %>"
        data-ai-model="<%= ENV['SUPPORT_AI_MODEL'].to_s %>"
      >
        <button class="mbk-support__fab" id="mbkSupportFab" type="button" aria-label="Abrir soporte">
          <i class="fa-solid fa-comments"></i>
        </button>

        <div class="mbk-support__panel shadow-soft" id="mbkSupportPanel" hidden>
          <div class="mbk-support__head">
            <div>
              <div class="mbk-support__title">Soporte</div>
              <div class="mbk-support__sub">Respuestas rapidas + WhatsApp</div>
            </div>
            <button class="mbk-support__close" id="mbkSupportClose" type="button" aria-label="Cerrar">×</button>
          </div>

          <div class="mbk-support__chat" id="mbkSupportChat"></div>

          <div class="mbk-support__composer">
            <input id="mbkSupportMsg" class="form-control" placeholder="Escribi tu pregunta..." />
            <button id="mbkSupportSend" class="btn btn-dark" type="button">Enviar</button>
          </div>

          <div class="mbk-support__hint">Si no encontramos respuesta, te llevamos directo a WhatsApp.</div>
        </div>
      </div>
    <% end %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
