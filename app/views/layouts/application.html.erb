<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Mega Bike</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <%= stylesheet_link_tag "application", media: "all" %>
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">Mega Bike</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" href="/nosotros">Nosotros</a></li>
            <li class="nav-item"><a class="nav-link" href="/products">Productos</a></li>
            <li class="nav-item"><a class="nav-link" href="/appointments/new">Servicios (turnos)</a></li>
            <li class="nav-item"><a class="nav-link" href="/custom_quotes/new">Personalizado</a></li>
            <li class="nav-item"><a class="nav-link" href="/faq">FAQ</a></li>
          </ul>

          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/cart"><i class="fa-solid fa-cart-shopping"></i> Carrito</a>
            </li>

            <% if logged_in? %>
              <% if admin? %>
                <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
              <% end %>
              <li class="nav-item"><span class="navbar-text me-2">Hola, <%= current_user.name %></span></li>
              <li class="nav-item">
                <%= button_to "Salir", logout_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
              </li>
            <% else %>
              <li class="nav-item"><a class="nav-link" href="/login">Ingresar</a></li>
              <li class="nav-item"><a class="btn btn-warning btn-sm ms-2" href="/registro">Crear cuenta</a></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="border-top py-4 bg-white">
      <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
        <div>
          <div class="fw-bold">Mega Bike</div>
          <div class="text-muted">Bicicletería · Ventas · Service</div>
        </div>
        <div class="text-muted">© <%= Time.current.year %> Mega Bike</div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
