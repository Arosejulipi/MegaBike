<h1 class="h3 fw-bold mb-3">Agendar turno de service</h1>

<!-- Build: <%= ENV["RENDER_GIT_COMMIT"].to_s[0, 7] %> Times: <%= Appointment.allowed_time_options.join(",") %> -->

<p class="text-muted mb-4">
  Realizamos mantenimientos y todo tipo de service: frenos, cambios, ruedas, ajustes generales, armado y mas.
  Elegi una fecha y un horario, y te confirmamos por mail.
</p>

<div class="card shadow-soft">
  <div class="card-body p-4">
    <%= form_with model: @appointment, local: true do |f| %>
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :full_name, "Nombre y apellido", class: "form-label" %>
          <%= f.text_field :full_name, value: (f.object.full_name.presence || (current_user.name if logged_in?)), class: "form-control" %>
        </div>

        <% if logged_in? %>
          <div class="col-md-6">
            <label class="form-label">Email de confirmacion</label>
            <input type="email" class="form-control" value="<%= current_user.email %>" disabled>
          </div>
        <% else %>
          <div class="col-md-6">
            <%= f.label :email, "Email", class: "form-label" %>
            <%= f.email_field :email, class: "form-control" %>
          </div>
        <% end %>

        <div class="col-md-6">
          <%= f.label :phone, "Telefono (opcional)", class: "form-label" %>
          <%= f.text_field :phone, class: "form-control", placeholder: "+549..." %>
        </div>

        <div class="col-md-6">
          <%= f.label :service_type, "Tipo de mantenimiento", class: "form-label" %>
          <%= f.select :service_type, ["Service basico", "Frenos", "Cambios", "Ruedas", "Armado", "Otro"], {}, class: "form-select" %>
        </div>

        <div class="col-md-6">
          <%= f.label :preferred_date, "Fecha preferida (turno)", class: "form-label" %>
          <%= f.date_field :preferred_date, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= f.label :preferred_time, "Horario preferido", class: "form-label" %>
          <%= f.select :preferred_time, nil, { include_blank: "Elegir horario..." }, class: "form-select" do %>
            <optgroup label="Manana">
              <% Appointment.build_slots("08:30", "13:30", step_minutes: 30).each do |t| %>
                <option value="<%= t %>" <%= "selected" if f.object.preferred_time.to_s == t %>><%= t %></option>
              <% end %>
            </optgroup>
            <optgroup label="Tarde">
              <% Appointment.build_slots("16:00", "19:00", step_minutes: 30).each do |t| %>
                <option value="<%= t %>" <%= "selected" if f.object.preferred_time.to_s == t %>><%= t %></option>
              <% end %>
            </optgroup>
          <% end %>
          <div class="form-text">Horarios disponibles: 08:30-13:30 y 16:00-19:00.</div>
        </div>

        <div class="col-12">
          <%= f.label :notes, "Mensaje (opcional)", class: "form-label" %>
          <%= f.text_area :notes, class: "form-control", rows: 3 %>
        </div>
      </div>

      <div class="mt-4">
        <%= f.submit "Enviar turno", class: "btn btn-dark" %>
      </div>

      <% if @appointment.errors.any? %>
        <div class="alert alert-danger mt-3">
          <div class="fw-bold">Revisa:</div>
          <ul class="mb-0">
            <% @appointment.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

