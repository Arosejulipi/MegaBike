<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 fw-bold mb-0">Admin · Productos</h1>
  <a class="btn btn-dark" href="/admin/products/new">Nuevo</a>
</div>

<div class="card shadow-soft">
  <div class="card-body p-4">
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th>Nombre</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Stock</th>
            <th>Activo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |p| %>
            <tr>
              <td><%= p.name %></td>
              <td class="text-end">$ <%= p.price.to_i %></td>
              <td class="text-end"><%= p.stock %></td>
              <td><%= p.active ? "Sí" : "No" %></td>
              <td class="text-end">
                <a class="btn btn-sm btn-outline-dark" href="/admin/products/<%= p.id %>">Ver</a>
                <a class="btn btn-sm btn-outline-dark" href="/admin/products/<%= p.id %>/edit">Editar</a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
