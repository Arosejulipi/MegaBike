<div class="card shadow-soft" style="max-width: 760px;">
  <div class="card-body p-4">
    <%= form_with model: [:admin, product], local: true do |f| %>
      <% if product.image_url.to_s.strip != "" %>
        <div class="mb-3">
          <div class="mbk-admin-img-preview" style="--mbk-img: url('<%= product.image_url %>');"></div>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, "Nombre", class: "form-label" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :description, "Descripcion", class: "form-label" %>
        <%= f.text_area :description, class: "form-control", rows: 4 %>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :brand, "Marca", class: "form-label" %>
          <%= f.text_field :brand, class: "form-control", placeholder: "Ej: Shimano, SRAM, Venzo..." %>
        </div>
        <div class="col-md-6">
          <%= f.label :category, "Categoria / Componente", class: "form-label" %>
          <%= f.text_field :category, class: "form-control", placeholder: "Ej: Frenos, Cambios, Ruedas..." %>
        </div>
      </div>

      <div class="mt-3">
        <%= f.label :image_url, "Foto (URL)", class: "form-label" %>
        <%= f.url_field :image_url, class: "form-control", placeholder: "Pega el link de la foto (https://...)" %>
        <div class="form-text">Recomendacion: usa una imagen horizontal y con buena luz.</div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-4">
          <%= f.label :price, "Precio", class: "form-label" %>
          <%= f.number_field :price, step: 1, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= f.label :stock, "Stock", class: "form-label" %>
          <%= f.number_field :stock, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= f.label :active, "Activo", class: "form-label" %>
          <%= f.select :active, [["Si", true], ["No", false]], {}, class: "form-select" %>
        </div>
      </div>

      <div class="mt-4 d-flex gap-2">
        <%= f.submit "Guardar", class: "btn btn-dark" %>
        <a class="btn btn-outline-dark" href="/admin/products">Volver</a>
      </div>

      <% if product.errors.any? %>
        <div class="alert alert-danger mt-3">
          <ul class="mb-0">
            <% product.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

