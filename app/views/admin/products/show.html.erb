<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 fw-bold mb-1"><%= @product.name %></h1>
    <div class="text-muted">
      <%= @product.brand %>
      <% if @product.brand.to_s.strip != "" && @product.category.to_s.strip != "" %>
        <span class="mx-1">·</span>
      <% end %>
      <%= @product.category %>
    </div>
  </div>

  <div class="d-flex gap-2">
    <a class="btn btn-outline-dark" href="/admin/products/<%= @product.id %>/edit">Editar</a>
    <%= button_to "Eliminar", admin_product_path(@product), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Eliminar producto?" } %>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card shadow-soft h-100">
      <div class="card-body p-3">
        <% if @product.image_url.to_s.strip != "" %>
          <div class="mbk-product-media" style="--mbk-img: url('<%= @product.image_url %>');"></div>
        <% else %>
          <div class="mbk-product-media mbk-product-media--empty">
            <i class="fa-solid fa-image"></i>
          </div>
        <% end %>
        <% if @product.image_url.to_s.strip != "" %>
          <div class="text-muted small mt-2">URL: <%= @product.image_url %></div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card shadow-soft h-100">
      <div class="card-body p-4">
        <div class="text-muted"><%= @product.description %></div>
        <div class="mt-3 d-flex flex-wrap gap-2">
          <span class="badge text-bg-warning">$ <%= @product.price.to_i %></span>
          <span class="badge text-bg-secondary">Stock: <%= @product.stock %></span>
          <span class="badge text-bg-<%= @product.active ? "success" : "danger" %>"><%= @product.active ? "Activo" : "Inactivo" %></span>
        </div>

        <div class="mt-4">
          <a class="btn btn-outline-dark" href="/admin/products">Volver</a>
        </div>
      </div>
    </div>
  </div>
</div>

