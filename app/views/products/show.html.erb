<div class="row g-4">
  <div class="col-md-7">
    <div class="card shadow-soft">
      <div class="card-body p-4">
        <h1 class="h3 fw-bold"><%= @product.name %></h1>
        <p class="text-muted"><%= @product.description %></p>
        <div class="d-flex align-items-center gap-2">
          <span class="badge text-bg-warning fs-6">$ <%= @product.price.to_i %></span>
          <span class="text-muted">Stock: <%= @product.stock %></span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card shadow-soft">
      <div class="card-body p-4">
        <% unless admin? %>
          <div class="fw-bold mb-2">Agregar al carrito</div>
          <%= form_with url: add_item_cart_path, method: :post, local: true do |f| %>
            <%= hidden_field_tag :product_id, @product.id %>
            <div class="mb-3">
              <label class="form-label">Cantidad</label>
              <%= number_field_tag :quantity, 1, min: 1, class: "form-control" %>
            </div>
            <%= f.submit "Agregar", class: "btn btn-dark w-100" %>
          <% end %>
          <div class="mt-3">
            <a class="btn btn-outline-dark w-100" href="/cart">Ir al carrito</a>
          </div>
        <% else %>
          <div class="text-muted">
            Estás en modo admin. Las compras y el carrito están deshabilitados.
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
