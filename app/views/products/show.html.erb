<div class="row g-4">
  <div class="col-lg-7">
    <div class="card shadow-soft">
      <div class="card-body p-3 p-md-4">
        <div class="mbk-product-media" style="--mbk-img: url('<%= @product.image_url.to_s %>');">
          <% if @product.image_url.to_s.strip == "" %>
            <div class="mbk-product-media__placeholder"><i class="fa-solid fa-bicycle"></i></div>
          <% end %>
        </div>

        <div class="mt-3">
          <h1 class="h3 fw-bold mb-1"><%= @product.name %></h1>
          <div class="text-muted">
            <%= [@product.brand, @product.category].reject { |x| x.to_s.strip == "" }.join(" · ") %>
          </div>
          <p class="text-muted mt-2 mb-0"><%= @product.description %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card shadow-soft">
      <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge mbk-price fs-6">$ <%= @product.price.to_i %></span>
          <span class="text-muted">Stock: <%= @product.stock %></span>
        </div>

        <hr />

        <% unless admin? %>
          <div class="fw-bold mb-2">Agregar al carrito</div>
          <%= form_with url: add_item_cart_path, method: :post, local: true do |f| %>
            <%= hidden_field_tag :product_id, @product.id %>
            <div class="mb-3">
              <label class="form-label">Cantidad</label>
              <%= number_field_tag :quantity, 1, min: 1, class: "form-control" %>
            </div>
            <%= f.submit "Agregar", class: "btn btn-dark w-100" %>
          <% end %>
          <div class="mt-3">
            <a class="btn btn-outline-dark w-100" href="/cart">Ir al carrito</a>
          </div>
        <% else %>
          <div class="text-muted">
            Estas en modo admin. Las compras y el carrito estan deshabilitados.
          </div>
        <% end %>

        <div class="mt-3">
          <a class="btn btn-outline-dark w-100" href="/products">Volver al catalogo</a>
        </div>
      </div>
    </div>
  </div>
</div>

