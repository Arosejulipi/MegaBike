<h1 class="h3 fw-bold mb-3">Bicicleta personalizada</h1>

<div class="card shadow-soft">
  <div class="card-body p-4">
    <p class="text-muted">Elegí lo que buscás y te contactamos con un presupuesto.</p>

    <%= form_with model: @custom_quote, local: true do |f| %>
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :full_name, "Nombre y apellido", class: "form-label" %>
          <%= f.text_field :full_name, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :phone, "Teléfono", class: "form-label" %>
          <%= f.text_field :phone, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :bike_type, "Tipo de bici", class: "form-label" %>
          <%= f.select :bike_type, ["Urbana", "MTB", "Ruta", "Plegable", "Eléctrica"], {}, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= f.label :frame_size, "Talle de cuadro", class: "form-label" %>
          <%= f.select :frame_size, ["S", "M", "L", "XL"], { include_blank: "No sé" }, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= f.label :color, "Color", class: "form-label" %>
          <%= f.text_field :color, class: "form-control", placeholder: "Ej: Negro mate" %>
        </div>
        <div class="col-md-4">
          <%= f.label :brakes, "Frenos", class: "form-label" %>
          <%= f.select :brakes, ["V-Brake", "Disco mecánico", "Disco hidráulico"], { include_blank: "Indistinto" }, class: "form-select" %>
        </div>
        <div class="col-md-6">
          <%= f.label :gears, "Cambios", class: "form-label" %>
          <%= f.select :gears, ["Sin cambios", "1x", "2x", "3x"], { include_blank: "Indistinto" }, class: "form-select" %>
        </div>
        <div class="col-md-6">
          <%= f.label :budget_range, "Rango de presupuesto", class: "form-label" %>
          <%= f.select :budget_range, ["Económico", "Intermedio", "Premium"], {}, class: "form-select" %>
        </div>
        <div class="col-12">
          <%= f.label :extra_notes, "Detalles extra (opcional)", class: "form-label" %>
          <%= f.text_area :extra_notes, class: "form-control", rows: 3, placeholder: "Ej: portaequipaje, canasto, luces, rodado, uso, etc." %>
        </div>
      </div>

      <div class="mt-4">
        <%= f.submit "Enviar pedido", class: "btn btn-dark" %>
      </div>

      <% if @custom_quote.errors.any? %>
        <div class="alert alert-danger mt-3">
          <div class="fw-bold">Revisá:</div>
          <ul class="mb-0">
            <% @custom_quote.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
