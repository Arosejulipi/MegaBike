<div class="hero p-4 p-md-5 shadow-soft">
  <div class="row align-items-center g-4">
    <div class="col-md-7">
      <h1 class="display-6 fw-bold">Tu bici, tu estilo 🚴‍♀️</h1>
      <p class="lead text-white-50 mb-4">Ventas, repuestos y service. Turnos online y presupuesto de bicicletas personalizadas.</p>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-warning btn-lg" href="/products">Ver productos</a>
        <a class="btn btn-outline-light btn-lg" href="/appointments/new">Agendar turno</a>
        <a class="btn btn-outline-light btn-lg" href="/custom_quotes/new">Personalizado</a>
      </div>
    </div>
    <div class="col-md-5">
      <div class="bg-dark bg-opacity-25 p-4 rounded-4">
        <div class="d-flex gap-3">
          <div class="text-warning fs-2"><i class="fa-solid fa-bicycle"></i></div>
          <div>
            <div class="fw-bold">Atención rápida</div>
            <div class="text-white-50">Te respondemos por mail con el detalle de tu pedido.</div>
          </div>
        </div>
        <hr class="border-light border-opacity-25" />
        <div class="d-flex gap-3">
          <div class="text-warning fs-2"><i class="fa-solid fa-screwdriver-wrench"></i></div>
          <div>
            <div class="fw-bold">Service y mantenimiento</div>
            <div class="text-white-50">Agenda de turnos y recepción de solicitudes.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mt-5">
  <h2 class="h4 fw-bold mb-3">Productos destacados</h2>
  <div class="row g-3">
    <% @featured_products.each do |p| %>
      <div class="col-12 col-md-4">
        <div class="card shadow-soft h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="fw-bold"><%= p.name %></div>
                <div class="text-muted small"><%= truncate(p.description, length: 90) %></div>
              </div>
              <span class="badge text-bg-warning">$ <%= p.price.to_i %></span>
            </div>
          </div>
          <div class="card-footer bg-white border-0 pb-3">
            <a class="btn btn-dark w-100" href="/products/<%= p.id %>">Ver</a>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
