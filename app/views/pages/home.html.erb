<div
  class="hero hero--photo p-4 p-md-5 shadow-soft"
  style="--mbk-hero-url: url('<%= (ENV['HERO_IMAGE_URL'].presence || '/megabike_hero.png') %>');"
>
  <div class="row align-items-center g-4">
    <div class="col-md-7">
      <h1 class="display-6 fw-bold mb-2">MegaBike</h1>
      <p class="lead text-white-50 mb-4">
        Bicicletas, repuestos y service. Saca turno online o pedi presupuesto para una bici personalizada.
      </p>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-warning btn-lg" href="/products">Ver productos</a>
        <a class="btn btn-outline-light btn-lg" href="/appointments/new">Servicios</a>
        <a class="btn btn-outline-light btn-lg" href="/custom_quotes/new">Personalizado</a>
      </div>
      <% if Rails.env.development? %>
        <div class="text-white-50 small mt-3">
          Tip: guarda una foto como <code>public/megabike_hero.jpg</code> (o configura <code>HERO_IMAGE_URL</code>).
        </div>
      <% end %>
    </div>

    <div class="col-md-5">
      <div class="bg-dark bg-opacity-25 p-4 rounded-4">
        <div class="d-flex gap-3">
          <div class="text-warning fs-2"><i class="fa-solid fa-bicycle"></i></div>
          <div>
            <div class="fw-bold">Atencion clara</div>
            <div class="text-white-50">Te llega un mail con el detalle del turno o del pedido.</div>
          </div>
        </div>
        <hr class="border-light border-opacity-25" />
        <div class="d-flex gap-3">
          <div class="text-warning fs-2"><i class="fa-solid fa-screwdriver-wrench"></i></div>
          <div>
            <div class="fw-bold">Service y mantenimiento</div>
            <div class="text-white-50">Turnos de 08:30-13:30 y 16:00-19:00.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mt-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
    <div>
      <h2 class="h4 fw-bold mb-1">Productos destacados</h2>
      <div class="text-muted">Esta semana: 10% OFF en destacados.</div>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-dark" href="/products">Ver catalogo</a>
      <a class="btn btn-dark" href="/custom_quotes/new">Personaliza tu bicicleta</a>
    </div>
  </div>

  <div class="row g-3">
    <% @featured_products.each do |p| %>
      <% price = p.price.to_f %>
      <% sale = (price * 0.90).round %>

      <div class="col-12 col-md-6 col-xl-4">
        <div class="card shadow-soft h-100 mbk-featured-card">
          <div class="mbk-product-card-img" style="--mbk-img: url('<%= p.image_url.to_s %>');">
            <% if p.image_url.to_s.strip == "" %>
              <div class="mbk-product-card-img__placeholder"><i class="fa-solid fa-bicycle"></i></div>
            <% end %>
            <div class="mbk-sale-badge">-10%</div>
          </div>

          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <div class="fw-bold"><%= p.name %></div>
                <div class="text-muted small">
                  <%= [p.brand, p.category].reject { |x| x.to_s.strip == "" }.join(" · ") %>
                </div>
              </div>
              <div class="text-end">
                <div class="text-muted small mbk-price-old">$ <%= price.to_i %></div>
                <div class="badge mbk-price">$ <%= sale %></div>
              </div>
            </div>

            <div class="text-muted small mt-2"><%= truncate(p.description, length: 90) %></div>
          </div>

          <div class="card-footer bg-white border-0 pb-3">
            <div class="d-grid gap-2">
              <a class="btn btn-dark" href="/products/<%= p.id %>">Ver detalle</a>
              <a class="btn btn-outline-dark" href="/custom_quotes/new">Quiero personalizar</a>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="col-12">
      <div class="card shadow-soft mbk-cta-card">
        <div class="card-body p-4 p-md-5 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <div class="fw-bold fs-4">Tu bici, a tu medida</div>
            <div class="text-muted">
              Arma una bici comoda, liviana y con el look que queres. Completa el formulario y te presupuestamos por mail.
            </div>
          </div>
          <div class="d-flex gap-2">
            <a class="btn btn-dark" href="/custom_quotes/new">Empezar personalizacion</a>
            <a class="btn btn-outline-dark" href="/appointments/new">Pedir turno de service</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
