<h1 class="h3 fw-bold mb-3">Ingresar</h1>

<div class="card shadow-soft" style="max-width: 520px;">
  <div class="card-body p-4">
    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <%= email_field_tag :email, params[:email], class: "form-control" %>
      </div>
      <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <%= password_field_tag :password, nil, class: "form-control" %>
      </div>
      <%= f.submit "Ingresar", class: "btn btn-dark w-100" %>
    <% end %>

    <div class="text-muted small mt-3">¿No tenés cuenta? <a href="/registro">Registrate</a></div>
  </div>
</div>
