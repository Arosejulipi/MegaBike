<h1 class="h3 fw-bold mb-3">Asistente (FAQ)</h1>

<div class="row g-3">
  <div class="col-md-7">
    <div class="card shadow-soft">
      <div class="card-body p-4">
        <h2 class="h5 fw-bold">Preguntas frecuentes</h2>
        <ul class="text-muted">
          <li>¿Cómo agendo un turno de service?</li>
          <li>¿Hacen envíos?</li>
          <li>¿Cómo pido una bici personalizada?</li>
          <li>¿Qué medios de pago aceptan?</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card shadow-soft">
      <div class="card-body p-4">
        <div class="fw-bold mb-2">Chat rápido</div>
        <div id="chat" class="border rounded-4 p-3 bg-white" style="height: 320px; overflow:auto;"></div>
        <div class="d-flex gap-2 mt-3">
          <input id="msg" class="form-control" placeholder="Escribí tu pregunta..." />
          <button id="send" class="btn btn-dark">Enviar</button>
        </div>
        <div class="text-muted small mt-2">Tip: probá escribir “turno”, “envíos”, “pago” o “personalizada”.</div>
      </div>
    </div>
  </div>
</div>

<script>
  const chat = document.getElementById('chat');
  const msg = document.getElementById('msg');
  const send = document.getElementById('send');

  function addLine(who, text) {
    const div = document.createElement('div');
    div.className = 'mb-2';
    div.innerHTML = `<span class="fw-bold">${who}:</span> ${text}`;
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
  }

  function botAnswer(q) {
    const t = q.toLowerCase();
    if (t.includes('turno') || t.includes('service') || t.includes('servicio')) {
      return 'Podés agendar desde “Servicios (turnos)”. Completás el formulario y nos llega tu pedido por mail.';
    }
    if (t.includes('envio') || t.includes('envíos') || t.includes('envios')) {
      return 'Sí, hacemos envíos. Te confirmamos costo y tiempos cuando realizás la compra o nos escribís.';
    }
    if (t.includes('pago') || t.includes('tarjeta') || t.includes('transfer')) {
      return 'Aceptamos efectivo, transferencia y tarjetas (según disponibilidad). Te lo confirmamos al contactarte.';
    }
    if (t.includes('personal') || t.includes('personalizada') || t.includes('presupuesto')) {
      return 'Entrá a “Personalizado”, elegí tus preferencias y enviá el pedido. Nos llega por mail con todos los detalles.';
    }
    return 'No estoy segura 😅 Probá con: “turno”, “envíos”, “pago” o “personalizada”.';
  }

  addLine('Asistente', 'Hola 👋 ¿En qué te ayudo?');

  function onSend() {
    const q = msg.value.trim();
    if (!q) return;
    addLine('Vos', q);
    msg.value = '';
    setTimeout(() => addLine('Asistente', botAnswer(q)), 150);
  }

  send.addEventListener('click', onSend);
  msg.addEventListener('keydown', (e) => { if (e.key === 'Enter') onSend(); });
</script>
